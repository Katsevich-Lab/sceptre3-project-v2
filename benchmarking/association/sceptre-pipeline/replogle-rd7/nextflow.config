process {
 queue = '16xl.q'

 // run_association_analysis is submitted as an SGE array job (see the `array`
 // directive in the pipeline). Two overrides, scoped to this process only:
 //  1. queue -> hpc3.q: with a fixed 90 workers, the biggest Replogle run (~2.4M pairs)
 //     makes pods ~5h long, which exceeds short.q's 4h cap. hpc3.q allows ~365d walltime
 //     (h_rt 8760:0:0) AND has ~100-200 slots, so pods aren't killed and still run wide.
 //     The memory-heavy combine step and all other processes stay on 16xl.q (profile default).
 //  2. clusterOptions: Wharton's submit verifier requires array-job output paths to be
 //     unique per task, so add $TASK_ID to the -o path (regular jobs keep the profile's
 //     default). Mirrors profile_16xl's clusterOptions; keep in sync if that changes.
 withName: 'run_association_analysis' {
   queue = 'hpc3.q'
   clusterOptions = { task.memory
     ? "-P stat_ekatsevi_team -l m_mem_free=${task.memory.toGiga()}G -o \$HOME/logs/$workflow.runName/\'\$JOB_NAME-\$JOB_ID-\$TASK_ID.log\'"
     : "-P stat_ekatsevi_team -o \$HOME/logs/$workflow.runName/\'\$JOB_NAME-\$JOB_ID-\$TASK_ID.log\'" }
 }
}

trace {
  enabled = true
  file    = 'trace.tsv'
  sep     = '\t'
  overwrite = true
  // choose your columns:
  fields  = 'task_id,process,tag,attempt,cpus,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,read_bytes,write_bytes'
}

report {
  overwrite = true        
}

timeline {
  overwrite = true
}

dag {
  overwrite = true
}
