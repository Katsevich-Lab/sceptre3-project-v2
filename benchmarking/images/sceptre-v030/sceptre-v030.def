Bootstrap: docker
# Pins R 4.6.0 and the CRAN snapshot of 2026-06-23, which rocker sets in Rprofile.site.
From: rocker/r-ver:4.6.0

%labels
    Author Louis
    Description Historical SCEPTRE v0.3.0 (Katsevich-Lab/sceptre @ tag v0.3.0), installed as the sole `sceptre` package. Used to benchmark the v0.3.0-era method (single-call run_sceptre_lowmoi / run_sceptre_highmoi API). R 4.6.0, CRAN 2026-06-23.
    Version 2.0

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        procps \
        build-essential \
        gfortran \
        cmake \
        curl \
        git \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        zlib1g-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libfribidi-dev \
        libharfbuzz-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff5-dev \
        pkg-config
    rm -rf /var/lib/apt/lists/*

    # sceptre pinned to the v0.3.0 tag, installing as package `sceptre` version 0.3.0.
    # It has C++ sources (LinkingTo: Rcpp, BH), which the toolchain above compiles.
    R --slave -e 'install.packages("remotes")'
    R --slave -e 'remotes::install_github("Katsevich-Lab/sceptre", ref="v0.3.0", dependencies=TRUE, upgrade="never")'

    mkdir -p /opt/sceptre-v030

%runscript
    exec "$@"

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH
    export R_LIBS_USER=

%test
    # Any failing check below aborts the build (apptainer otherwise takes only the
    # last command's exit status).
    set -e
    which ps
    ps -o pid,comm | head -n 2
    # Fail the build unless this is the v0.3.0 build: version 0.3.0, exporting the
    # v0.3.0-era single-call entry points.
    R --quiet -e 'suppressPackageStartupMessages(library(sceptre)); stopifnot(as.character(packageVersion("sceptre")) == "0.3.0"); stopifnot(exists("run_sceptre_lowmoi", mode="function"), exists("run_sceptre_highmoi", mode="function")); cat("sceptre", as.character(packageVersion("sceptre")), "OK\n")'
    # Record R and every installed package version in the build log.
    R --quiet -e 'cat(R.version.string, "\n"); ip <- as.data.frame(installed.packages()[, c("Package","Version")], stringsAsFactors=FALSE); print(ip[order(ip$Package), ], row.names=FALSE)'
