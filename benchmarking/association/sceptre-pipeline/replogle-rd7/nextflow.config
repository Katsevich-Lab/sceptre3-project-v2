process {
 queue = '16xl.q'

 // run_association_analysis is submitted as an SGE array job (see the `array`
 // directive in the pipeline). It runs on 16xl.q (the default above) -- per-project
 // RQS slot caps (qconf -srqs) are 16xl.q=576, short.q=128, hpc3.q=64, so 16xl.q is the
 // only queue whose cap fits all 90 workers at once. It also has long walltime (handles
 // the ~5h pods that break short.q's 4h cap) and big-memory nodes (fits the ~6-10GB pods).
 // Overrides here:
 //  - errorStrategy 'retry' / maxRetries: the 16xl.q nodes are elastic and get reclaimed
 //    mid-run (observed: 12 tasks on one node all killed at ~40s, exit 140, while tasks
 //    on other nodes finished fine). qacct confirmed it's NOT memory (peaks ~6G under the
 //    10G reservation) or walltime (~40s vs 8h) -- it's node preemption. Retrying resubmits
 //    a killed pod onto a healthy node instead of letting one casualty abort the whole run.
 //  - clusterOptions: Wharton's submit verifier requires array-job output paths to be
 //    unique per task, so add $TASK_ID to the -o path. Mirrors profile_16xl's
 //    clusterOptions; keep in sync if that changes.
 withName: 'run_association_analysis' {
   errorStrategy = 'retry'
   maxRetries = 3
   clusterOptions = { task.memory
     ? "-P stat_ekatsevi_team -l m_mem_free=${task.memory.toGiga()}G -o \$HOME/logs/$workflow.runName/\'\$JOB_NAME-\$JOB_ID-\$TASK_ID.log\'"
     : "-P stat_ekatsevi_team -o \$HOME/logs/$workflow.runName/\'\$JOB_NAME-\$JOB_ID-\$TASK_ID.log\'" }
 }
}

executor {
  exitReadTimeout   = '60 min'   // default 270s; must exceed longest task runtime
  queueStatInterval = '2 min'    // poll qstat less aggressively (default 1 min)
}

trace {
  enabled = true
  file    = 'trace.tsv'
  sep     = '\t'
  overwrite = true
  // choose your columns:
  fields  = 'task_id,process,tag,attempt,cpus,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,read_bytes,write_bytes'
}

report {
  overwrite = true        
}

timeline {
  overwrite = true
}

dag {
  overwrite = true
}
