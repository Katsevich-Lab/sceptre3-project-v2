// === Core paths ===
// workDir is deliberately not set here: it is per-user scratch, so it comes from
// ~/.nextflow/config (or `-w <dir>` on the command line).

params {
  // Input/output roots
  dataset_base_dir = "$HOME/data/projects/sceptre3/benchmarking/association/computational/input_data"
  out_base_dir     = "$HOME/data/projects/sceptre3/benchmarking/association/computational/outputs"

  // Apptainer images (built from benchmarking/images/<name>/) and conda envs, kept in
  // project space. Override with --images_dir / --conda_cache_dir.
  images_dir   = "$HOME/data/projects/sceptre3/benchmarking/pipeline-images"
  conda_cache_dir = "$HOME/data/projects/sceptre3/benchmarking/pipeline-conda-caches"
  sceptre_sif  = "${params.images_dir}/sceptre.sif"
  sceptre_manuscript_sif = "${params.images_dir}/sceptre-manuscript.sif"
  sceptre_v030_sif = "${params.images_dir}/sceptre-v030.sif"
  mixscale_sif = "${params.images_dir}/mixscale.sif"

  // FR-Perturb uses conda from cloned repo
  frperturb_conda_env = "${projectDir}/../external/FR-Perturb/environment.yml"
}

// === SGE executor on Wharton HPC3 ===
process {
  executor = 'sge'
  penv = 'openmp'  // Tell Nextflow to use -pe instead of -l slots=

  // Build SGE flags per task
  clusterOptions = {
    def cpus  = (task.cpus ?: 1) as int
    // def memGB = ((task.memory ?: MemoryUnit.of('4 GB')).toGiga() as long)
    def memGB = task.memory.toGiga() as long // fail loud
    def perGB = Math.max(1L, (long) Math.ceil(memGB / (double) cpus))

    def cwd    = java.nio.file.Paths.get("").toAbsolutePath().toString()
    def logDir = "${cwd}/nf-logs"

    // Keep SGE vars literal by using single quotes
    def sgeOut = "-o ${logDir}/" + '$JOB_NAME.$JOB_ID.out'
    def sgeErr = "-e ${logDir}/" + '$JOB_NAME.$JOB_ID.err'

    // Note: -pe is handled automatically by penv setting
    // h_rt comes from each process's `time` directive (nextflow emits -l h_rt); don't set it here too.
    return "-P stat_ekatsevi_team -l m_mem_free=${perGB}G ${sgeOut} ${sgeErr}"
  }

  // Create log directory
  beforeScript = "mkdir -p nf-logs"

  // Per-task container options
  containerOptions = {
    def n = (task.cpus ?: 1) as int
    [
      "--env PYTHONNOUSERSITE=1",
      "--env PYTHONPATH=",
      "--env APPTAINER_TMPDIR=/tmp",
      "--env HDF5_USE_FILE_LOCKING=FALSE"
    ].join(' ')
  }
}

// === Containers ===
singularity {
  enabled    = true
  autoMounts = true
  runOptions = """
    --cleanenv \
    --bind ${params.dataset_base_dir}:${params.dataset_base_dir}:ro \
    --bind ${params.out_base_dir}:${params.out_base_dir}
  """.trim()
}

// === Conda ===
conda {
  enabled = true
  cacheDir = params.conda_cache_dir
}

// === Reports (overwrite between runs) ===
report   { overwrite = true }
timeline { overwrite = true }
trace    { overwrite = true }
dag      { overwrite = true }

trace {
  fields = 'task_id,process,tag,cpus,realtime,rss,peak_rss,%cpu,%mem,read_bytes,write_bytes'
}

// local profile for running on laptop
profiles {
  local {
    process {
      executor = 'local'
      // Remove SGE-specific clusterOptions
      clusterOptions = null
    }
  }
}
