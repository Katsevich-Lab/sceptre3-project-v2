//  cacheDir   = "${projectDir}/.apptainer-cache" // Use project-local image cache
//  runOptions = '--cleanenv --containall --bind $PWD:$PWD'
  // Explanation:
  //   --cleanenv    = strip host env vars (PYTHONPATH, etc.)
  //   --containall  = isolate from host filesystem
  //   --bind $PWD:$PWD = rebind working directory so data/scripts are visible inside container
//}


