Bootstrap: docker
# Pins R 4.6.0 and the CRAN snapshot of 2026-06-23, which rocker sets in Rprofile.site.
From: rocker/r-ver:4.6.0

%labels
    Author Louis
    Description Original 2021 manuscript-era sceptre (Katsevich-Lab/sceptre-manuscript, sceptre_package/sceptre, v1.0.0), installed as the sole `sceptre` package for benchmarking the published distilled-CRT + skew-t method. Pinned to commit 98fc64eb, R 4.6.0, CRAN 2026-06-23.
    Version 2.0

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # System deps. gfortran is required to compile the manuscript package's
    # dependencies (sn -> quantreg, VGAM, etc.); procps gives `ps`.
    apt-get update
    apt-get install -y --no-install-recommends \
        procps \
        build-essential \
        gfortran \
        cmake \
        curl \
        git \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        zlib1g-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libfribidi-dev \
        libharfbuzz-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff5-dev \
        pkg-config
    rm -rf /var/lib/apt/lists/*

    # The manuscript sceptre, pinned to commit 98fc64eb. It lives in a subdirectory of
    # the repo and installs as package `sceptre` v1.0.0; dependencies=TRUE pulls its
    # Depends (VGAM, sn, MASS, fst, bigstatsr, tidyverse, magrittr).
    R --slave -e 'install.packages("remotes")'
    R --slave -e 'remotes::install_github("Katsevich-Lab/sceptre-manuscript@98fc64ebd7f9eb9d6283e472752d557ec458fe32", subdir="sceptre_package/sceptre", dependencies=TRUE, upgrade="never")'

    mkdir -p /opt/sceptre-manuscript

%runscript
    # Pass-through so `ps`, `bash`, `Rscript`, etc. all work with `apptainer run`
    exec "$@"

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH
    # Avoid reading host user libraries when using --cleanenv
    export R_LIBS_USER=

%test
    # Any failing check below aborts the build (apptainer otherwise takes only the
    # last command's exit status).
    set -e
    which ps
    ps -o pid,comm | head -n 2
    # Fail the build unless this is the manuscript build: v1.0.0, exporting the
    # manuscript-only workhorse run_sceptre_using_precomp.
    R --quiet -e 'suppressPackageStartupMessages(library(sceptre)); stopifnot(as.character(packageVersion("sceptre")) == "1.0.0"); stopifnot(exists("run_sceptre_using_precomp", mode="function")); cat("manuscript sceptre", as.character(packageVersion("sceptre")), "OK\n")'
    # Record R and every installed package version in the build log.
    R --quiet -e 'cat(R.version.string, "\n"); ip <- as.data.frame(installed.packages()[, c("Package","Version")], stringsAsFactors=FALSE); print(ip[order(ip$Package), ], row.names=FALSE)'
