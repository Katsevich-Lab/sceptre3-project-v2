// === Core paths ===
// workDir is deliberately not set here: it is per-user scratch, so it comes from
// ~/.nextflow/config (or `-w <dir>` on the command line).

params {
  // Input/output roots — resolve to canonical paths so bind-mounts and staged
  // symlinks agree (~/data is a symlink, and a container given the symlinked
  // path cannot follow it to the real directory).
  dataset_base_dir = new File("$HOME/data/projects/sceptre3/benchmarking/guide_assignment/input_data").canonicalPath
  out_base_dir     = new File("$HOME/data/projects/sceptre3/benchmarking/guide_assignment/outputs").canonicalPath

  // Default per-task walltime when a config CSV has no `time` column.
  // Doubles as the deliberate timeout: a method that has not finished by then is
  // recorded as a failure rather than running forever.
  default_time = '48h'

  // Apptainer images (built from benchmarking/images/<name>/) and conda envs, kept in
  // project space. Override with --images_dir / --conda_cache_dir.
  images_dir  = "$HOME/data/projects/sceptre3/benchmarking/pipeline-images"
  conda_cache_dir = "$HOME/data/projects/sceptre3/benchmarking/pipeline-conda-caches"
  sceptre_sif = "${params.images_dir}/sceptre.sif"
  fishash_sif = "${params.images_dir}/fishash.sif"
}

// === Process defaults ===
// Executor, account, partition choice and modules are machine-specific and come
// from ~/.nextflow/config (on Betty: the lab's Slurm settings). Nothing here is
// tied to a particular cluster.
process {
  // === Graceful failure ===
  // Every method x dataset here is an INDEPENDENT benchmark leaf: nothing
  // downstream consumes their outputs. Nextflow's default errorStrategy is
  // 'terminate', which on the first non-zero exit kills the workflow AND cancels
  // its still-running siblings -- so one method hitting its memory or walltime
  // limit would take the whole run down. 'ignore' lets each method fail on its
  // own and the rest carry on, which is the point of the experiment.
  //
  // TRADEOFF: with 'ignore' the workflow EXITS 0 even when every method died.
  // The trace file below is the source of truth for what actually ran -- always
  // check it (or the onComplete summary) rather than the exit code.
  //
  // To retry OOM kills at larger memory instead of recording them as failures:
  //   errorStrategy = { task.exitStatus in [104,134,137,139,140,143] && task.attempt <= 2 ? 'retry' : 'ignore' }
  //   maxRetries    = 2
  //   memory        = { (resources.memory as nextflow.util.MemoryUnit) * task.attempt }
  errorStrategy = 'ignore'

  // Create persistent caches once per task (cheap, safe on shared FS)
  beforeScript = "mkdir -p ${projectDir}/.jax_cache ${projectDir}/.numba_cache ${projectDir}/.mplconfig"

  // Per-task container options: Python isolation (for sceptre only)
  containerOptions = [
    "--env PYTHONNOUSERSITE=1",
    "--env PYTHONPATH=",
    "--env APPTAINER_TMPDIR=/tmp",
    "--env HDF5_USE_FILE_LOCKING=FALSE"
  ].join(' ')

  // Conda-backed modules
  withLabel: crispat  { conda = "${projectDir}/modules/crispat/environment.yml" }
  withLabel: cleanser { conda = "${projectDir}/modules/cleanser/environment.yml" }
  withLabel: pertpy   { conda = "${projectDir}/modules/pertpy/environment.yml" }

  // Container-backed modules
  withLabel: sceptre { container = params.sceptre_sif }
}

// === Single-threaded methods ===
// Benchmarked methods must not parallelize, even when a task holds extra CPUs
// (on Betty, memory comes per CPU, so a task may need more CPUs than it uses).
// Two layers: these variables tell the math libraries to use one thread, and
// bin/pin_cores.sh (taskset) hard-limits each method to its intended cores:
// 1 for every method except cleanser, which runs its 4 MCMC chains on exactly 4.
// Nextflow passes the env scope into containers too.
env {
  OMP_NUM_THREADS      = '1'
  OMP_THREAD_LIMIT     = '1'
  OPENBLAS_NUM_THREADS = '1'
  MKL_NUM_THREADS      = '1'
  NUMEXPR_NUM_THREADS  = '1'
  VECLIB_MAXIMUM_THREADS = '1'
  BLIS_NUM_THREADS     = '1'
  NUMBA_NUM_THREADS    = '1'
  // JAX (pertpy): keep XLA's CPU backend on one thread
  XLA_FLAGS            = '--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1'
}


// === Conda / containers ===
conda {
  enabled  = true
  // Plain conda: modern conda already uses mamba's fast solver (libmamba).
  useMamba = false
  cacheDir = params.conda_cache_dir
  // Default is 20 min. conda builds envs one at a time and unpacking onto
  // network storage is slow: crispat's (PyTorch + pip) was killed at 20 min.
  createTimeout = '1 h'
  channels = ['conda-forge']
}

singularity {
  enabled    = true
  autoMounts = true
  runOptions = """
    --cleanenv \
    --bind ${params.dataset_base_dir}:${params.dataset_base_dir}:ro \
    --bind ${params.out_base_dir}:${params.out_base_dir}
  """.trim()
}

// === Reports (overwrite between runs) ===
report   { overwrite = true }
timeline { overwrite = true }
trace    { overwrite = true }
dag      { overwrite = true }

trace {
  // status + exit are ESSENTIAL here: errorStrategy='ignore' makes the workflow
  // exit 0 regardless, so this file is the only record of what failed and why.
  // native_id is the Slurm job id -- use it for
  // `sacct -j <id> --format=JobID,State,ExitCode,MaxRSS,Elapsed`
  // to recover the true peak of a task the kernel/Slurm killed.
  fields = 'task_id,native_id,process,tag,status,exit,error_action,attempt,cpus,memory,time,submit,duration,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,read_bytes,write_bytes,hostname,workdir'
}

// local profile for running on laptop
profiles {
  local {
    process {
      executor = 'local'
      // Drop any cluster options set by ~/.nextflow/config
      clusterOptions = null
    }
  }
}
