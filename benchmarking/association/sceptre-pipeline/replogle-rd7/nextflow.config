process {
 queue = '16xl.q'
}

trace {
  enabled = true
  file    = 'trace.tsv'
  sep     = '\t'
  overwrite = true
  // choose your columns:
  fields  = 'task_id,process,tag,attempt,cpus,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,read_bytes,write_bytes'
}

report {
  overwrite = true        
}

timeline {
  overwrite = true
}

dag {
  overwrite = true
}
