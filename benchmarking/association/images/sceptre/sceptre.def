Bootstrap: docker
# Pins R 4.6.0 and the CRAN snapshot of 2026-06-23, which rocker sets in Rprofile.site.
From: rocker/r-ver:4.6.0

%labels
    Author Louis Deutsch
    Description Modern sceptre for association benchmarking. sceptre commit 21f9ea09 (v0.99.0), R 4.6.0, CRAN 2026-06-23.
    Version 2.0

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # System deps (+ procps for `ps`)
    apt-get update
    apt-get install -y --no-install-recommends \
        procps \
        build-essential \
        cmake \
        curl \
        git \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        zlib1g-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libfribidi-dev \
        libharfbuzz-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff5-dev \
        pkg-config
    rm -rf /var/lib/apt/lists/*

    # sceptre, pinned to commit 21f9ea09 (v0.99.0, main as of 2026-08-31).
    R --slave -e 'install.packages("remotes")'
    R --slave -e 'remotes::install_github("Katsevich-Lab/sceptre@21f9ea098b69c444a884a49bc254de711968e3b5", dependencies=TRUE, upgrade="never")'

    # Working directory (optional)
    mkdir -p /opt/sceptre

%runscript
    # Pass-through so `ps`, `bash`, `Rscript`, etc. all work with `apptainer run`
    exec "$@"

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH
    # Avoid reading host user libraries when using --cleanenv
    export R_LIBS_USER=

%test
    which ps
    ps -o pid,comm | head -n 2
    # Fail the build if sceptre is not the pinned version.
    R --quiet -e 'suppressPackageStartupMessages(library(sceptre)); v <- as.character(packageVersion("sceptre")); if (v != "0.99.0") stop("expected sceptre 0.99.0 (commit 21f9ea09), got ", v); cat("sceptre ", v, " OK\n", sep="")'
    # Record R and every installed package version in the build log.
    R --quiet -e 'cat(R.version.string, "\n"); ip <- as.data.frame(installed.packages()[, c("Package","Version")], stringsAsFactors=FALSE); print(ip[order(ip$Package), ], row.names=FALSE)'


