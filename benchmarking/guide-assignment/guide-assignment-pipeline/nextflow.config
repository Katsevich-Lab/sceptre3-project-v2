// === Core paths ===
workDir = "${projectDir}/work"

params {
  // Input/output roots
  dataset_base_dir = "$HOME/data/projects/sceptre3/benchmarking/guide_assignment/input_data"
  out_base_dir     = "$HOME/data/projects/sceptre3/benchmarking/guide_assignment/outputs"

  // Containers live under modules/
  sceptre_sif = "${projectDir}/modules/sceptre/sceptre.sif"
}

// === SGE executor on Wharton HPC3 ===
process {
  executor = 'sge'

  // Build SGE flags per task
  clusterOptions = {
    def cpus  = (task.cpus ?: 1) as int
    def memGB = ((task.memory ?: MemoryUnit.of('4 GB')).toGiga() as long)
    def perGB = Math.max(1L, (long) Math.ceil(memGB / (double) cpus))

    def cwd    = java.nio.file.Paths.get("").toAbsolutePath().toString()
    def logDir = "${cwd}/nf-logs"

    // Keep SGE vars literal by using single quotes
    def sgeOut = "-o ${logDir}/" + '$JOB_NAME.$JOB_ID.out'
    def sgeErr = "-e ${logDir}/" + '$JOB_NAME.$JOB_ID.err'

    return "-pe openmp ${cpus} -l m_mem_free=${perGB}G ${sgeOut} ${sgeErr}"
  }

  // Create persistent caches once per task (cheap, safe on shared FS)
  beforeScript = {
    """
    mkdir -p ${projectDir}/.jax_cache ${projectDir}/.numba_cache ${projectDir}/.mplconfig nf-logs
    """
  }()

  // Per-task container options: Python isolation, thread caps, and persistent caches
  containerOptions = {
    def n = (task.cpus ?: 1) as int
    def jaxMax = 25L * 1024 * 1024 * 1024   // 25 GiB cache cap
    [
      "--env PYTHONNOUSERSITE=1",
      "--env PYTHONPATH=",
      "--env OMP_NUM_THREADS=${n}",
      "--env OPENBLAS_NUM_THREADS=${n}",
      "--env MKL_NUM_THREADS=${n}",

      // JAX stability & persistent compilation cache
      "--env JAX_COMPILATION_CACHE_DIR=${projectDir}/.jax_cache",
      "--env JAX_COMPILATION_CACHE_MAX_SIZE=${jaxMax}",
      "--env JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=0",
      "--env JAX_PERSISTENT_CACHE_MIN_ENTRY_SIZE_BYTES=-1",
      "--env JAX_PERSISTENT_CACHE_ENABLE_XLA_CACHES=all",

      // Numba cache (Scanpy uses numba) & Matplotlib config
      "--env NUMBA_CACHE_DIR=${projectDir}/.numba_cache",
      "--env MPLCONFIGDIR=${projectDir}/.mplconfig",

      // Keep container temp on node-local scratch
      "--env APPTAINER_TMPDIR=/tmp",

      // Optional: can reduce rare HDF5 lock stalls on networked FS
      "--env HDF5_USE_FILE_LOCKING=FALSE"
    ].join(' ')
  }
}


// === Conda / containers ===
conda {
  enabled  = true
  useMamba = true
  cacheDir = "${projectDir}/conda-cache"
  channels = ['conda-forge']
}

singularity {
  enabled    = true
  autoMounts = true
  cacheDir   = "${projectDir}/.apptainer-cache"
  runOptions = """
    --cleanenv \
    --bind ${params.dataset_base_dir}:${params.dataset_base_dir}:ro \
    --bind ${params.out_base_dir}:${params.out_base_dir}
  """.trim()
}

// === Per-module environments ===
process {
  // Conda-backed modules
  withLabel: crispat  { conda = "${projectDir}/modules/crispat/environment.yml" }
  withLabel: cleanser { conda = "${projectDir}/modules/cleanser/environment.yml" }
  withLabel: pertpy {
     conda = "${projectDir}/modules/pertpy/environment.yml" 
  }

  // Container-backed modules
  withLabel: sceptre { container = params.sceptre_sif }
}

// === Reports (overwrite between runs) ===
report   { overwrite = true }
timeline { overwrite = true }
trace    { overwrite = true }
dag      { overwrite = true }

trace {
  fields = 'task_id,process,tag,cpus,time,rss,peak_rss,%cpu,%mem,read_bytes,write_bytes'
}





profiles {
  gpu_pertpy {
    // Keep queue throttling like your home config (optional but handy)
    executor {
      queueSize = 100
      submitRateLimit = '25 sec'
    }

    process {
      // Hard override ONLY for this process
      withName: /.*PERTPY_ASSIGN.*/ {
        queue  = 'gpu.q'
        cpus   = 1
        memory = '30 GB'

        // Re-include the SGE project (-P) you need, plus GPU-safe flags
        clusterOptions = {
          def cwd    = java.nio.file.Paths.get("").toAbsolutePath().toString()
          def logDir = "${cwd}/nf-logs"
          def sgeOut = "-o ${logDir}/" + '$JOB_NAME.$JOB_ID.out'
          def sgeErr = "-e ${logDir}/" + '$JOB_NAME.$JOB_ID.err'
          // NOTE: -P is carried over here; adjust the project code if needed
          return "-P stat_ekatsevi_team -pe openmp 1 -l m_mem_free=30G -l h_rt=03:59:00 ${sgeOut} ${sgeErr}"
        }

        // JAX friendliness & logging 
        env = [
          'XLA_PYTHON_CLIENT_PREALLOCATE':'false',
          'XLA_PYTHON_CLIENT_MEM_FRACTION':'0.85',
          'JAX_LOG_COMPILES':'1',
          'JAX_COMPILATION_CACHE_DIR':"${projectDir}/.jax_cache",
          'JAX_COMPILATION_CACHE_MAX_SIZE':"${25L * 1024 * 1024 * 1024}"
        ]
      }

      // Make sure the log dir exists before SGE writes into it
      beforeScript = { """mkdir -p ${projectDir}/.jax_cache ${projectDir}/.numba_cache ${projectDir}/.mplconfig nf-logs""" }()
    }
  }
}
