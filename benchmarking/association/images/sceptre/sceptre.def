Bootstrap: docker
From: rocker/r-ver:4.4.3

%labels
    Author Louis Deutsch
    Description Sceptre guide assignment container (with procps + robustbase + MASS) from latest main
    Version 1.2

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # System deps (+ procps for `ps`)
    apt-get update
    apt-get install -y --no-install-recommends \
        procps \
        build-essential \
        cmake \
        curl \
        git \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        zlib1g-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libfribidi-dev \
        libharfbuzz-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff5-dev \
        pkg-config
    rm -rf /var/lib/apt/lists/*

    # R packages: remotes, then sceptre from GitHub (with dependencies)
    R --slave -e 'install.packages("remotes", repos="https://cran.r-project.org")'
    R --slave -e 'remotes::install_github("Katsevich-Lab/sceptre", dependencies=TRUE, upgrade="never")'

    # Extra CRAN packages used by bin/script/{variant}.R fitters
    # (MASS is also pulled in transitively via sceptre's deps -- listing it
    # here keeps the variants' requireNamespace() checks robust if that ever
    # changes upstream).
    R --slave -e 'install.packages(c("robustbase", "MASS"), repos="https://cran.r-project.org")'

    # Working directory (optional)
    mkdir -p /opt/sceptre

%runscript
    # Pass-through so `ps`, `bash`, `Rscript`, etc. all work with `apptainer run`
    exec "$@"

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH
    # Avoid reading host user libraries when using --cleanenv
    export R_LIBS_USER=

%test
    which ps
    ps -o pid,comm | head -n 2
    R --quiet -e 'suppressPackageStartupMessages(library(sceptre)); cat("sceptre ", as.character(packageVersion("sceptre")), " OK\n", sep="")'
    R --quiet -e 'suppressPackageStartupMessages(library(robustbase)); cat("robustbase ", as.character(packageVersion("robustbase")), " OK\n", sep="")'
    R --quiet -e 'suppressPackageStartupMessages(library(MASS)); cat("MASS ", as.character(packageVersion("MASS")), " OK\n", sep="")'


