process {
  queue = '16xl.q'

  // run_association_analysis is submitted as an SGE array job (see the `array`
  // directive in the pipeline; requires --num_assoc_workers, passed by the run script).
  // It runs on 16xl.q (the default above) -- per-project RQS slot caps (qconf -srqs) are
  // 16xl.q=576, short.q=128, hpc3.q=64, so 16xl.q is the only queue whose cap fits all 90
  // workers at once, and it has long walltime for the bigger pods.
  // Overrides here:
  //  - errorStrategy 'retry' / maxRetries: insurance against elastic-node reclamation
  //    (16xl.q nodes are autoscaled and can get preempted mid-run). A killed pod resubmits
  //    onto a healthy node instead of aborting the whole run.
  //  - clusterOptions: Wharton's submit verifier requires array-job output paths to be
  //    unique per task, so add $TASK_ID to the -o path. Mirrors profile_16xl's
  //    clusterOptions; keep in sync if that changes.
  withName: 'run_association_analysis' {
    errorStrategy = 'retry'
    maxRetries = 3
    clusterOptions = { task.memory
      ? "-P stat_ekatsevi_team -l m_mem_free=${task.memory.toGiga()}G -o \$HOME/logs/$workflow.runName/\'\$JOB_NAME-\$JOB_ID-\$TASK_ID.log\'"
      : "-P stat_ekatsevi_team -o \$HOME/logs/$workflow.runName/\'\$JOB_NAME-\$JOB_ID-\$TASK_ID.log\'" }
  }
}

executor {
  pollInterval      = '10 sec'
  // Prevent false "terminated by external system" retries: Nextflow's default
  // exitReadTimeout (270s) can expire while it waits for an array task's .exitcode file
  // after losing the qstat handshake, causing a needless double-run. Set it above the
  // longest pod runtime, and poll qstat less aggressively.
  exitReadTimeout   = '60 min'
  queueStatInterval = '2 min'
}

trace {
  enabled = true
  file    = 'trace.tsv'
  sep     = '\t'
  overwrite = true
  // choose your columns:
  fields  = 'task_id,process,tag,attempt,cpus,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,read_bytes,write_bytes'
}

report {
  overwrite = true
}

timeline {
  overwrite = true
}

dag {
  overwrite = true
}
